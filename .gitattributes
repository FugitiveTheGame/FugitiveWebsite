# The deploy scripts run on Linux; a CRLF shebang makes bash reject them.
* text=auto eol=lf

*.sh    text eol=lf
*.php   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.sql   text eol=lf
*.service text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
